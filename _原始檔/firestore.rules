rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 站長帳號（只讀後台用）
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "cuicui.tw@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // 會員資料文件（email 與名稱）：本人可讀寫，站長可讀
    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // 會員的星盤與筆記：本人可讀寫，站長可讀
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // 後台：讀取所有會員的星盤與筆記（collection group 查詢）
    match /{path=**}/charts/{chartId} {
      allow read: if isAdmin();
    }
    match /{path=**}/notes/{noteId} {
      allow read: if isAdmin();
    }

    // 網站閱覽人數：任何人只能把人數加一，只有站長可以讀取
    match /stats/{docId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.views == 1 && request.resource.data.keys().hasOnly(['views']);
      allow update: if request.resource.data.views == resource.data.views + 1 && request.resource.data.keys().hasOnly(['views']);
    }

    // 翠誌文章：所有人可讀已上架（published）的文章；草稿只有站長可讀；只有站長可以新增、修改、刪除
    // 翠誌分類：所有人可讀（前台篩選用）；只有站長可以寫入（分類由站長後台管理）
    match /postCats/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();

      // 文章留言：所有人可讀、所有人可留言（不需登入；暱稱最多 20 字、內容 1–500 字）；只有站長可刪除；不可修改
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['name', 'text', 'created'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 20
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.created == request.time;
        allow delete: if isAdmin();
        allow update: if false;
      }
    }
  }
}
