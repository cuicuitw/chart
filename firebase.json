{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "_原始檔/**",
      "網站設計稿/**",
      "CNAME",
      "README.md",
      "functions/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/blog/**",
        "function": {
          "functionId": "blog",
          "region": "asia-east1"
        }
      }
    ]
  },
  "firestore": {
    "rules": "_原始檔/firestore.rules"
  },
  "storage": {
    "rules": "_原始檔/storage.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  }
}
